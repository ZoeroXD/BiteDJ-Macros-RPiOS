[Unit]
Description=BiteDJ FLX4 hold launcher
# Never stop retrying, no matter how often it restarts
StartLimitIntervalSec=0

[Service]
ExecStart=/usr/bin/python3 %h/bin/bitedj-hold.py
Restart=always
RestartSec=3
# Restarting this service must never close BiteDJ or anything else it started
KillMode=process
Environment=DISPLAY=:0
Environment=WAYLAND_DISPLAY=wayland-0
Environment=XDG_RUNTIME_DIR=/run/user/%U

[Install]
WantedBy=default.target
